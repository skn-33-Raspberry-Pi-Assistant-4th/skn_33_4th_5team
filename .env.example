# PiCare Django + Qwen/LoRA 실행 설정 예시.
# RunPod에서는 이 파일을 .env로 복사한 뒤 실제 경로·호스트·Secret을 맞춘다.
# .env에는 API 키·토큰을 커밋하지 않는다.

# Django: SSH 터널은 localhost 설정 그대로 사용한다.
# RunPod HTTP 프록시를 사용할 경우 실제 프록시 호스트를 쉼표로 추가한다.
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_SECRET_KEY=<운영 환경에서 Secret으로 주입>
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_SSL_REDIRECT=false
# DJANGO_CSRF_TRUSTED_ORIGINS=https://<RunPod HTTP proxy host>

# MySQL: local Docker Compose and RunPod direct mysqld both use these names.
# 비어 있지 않은 DJANGO_DB_NAME/USER/PASSWORD/HOST/PORT가 있으면 해당 값이 우선한다.
# SQLite에서는 DJANGO_DB_ENGINE=django.db.backends.sqlite3로 바꾸고 아래 경로 변수를 사용한다.
# DJANGO_SQLITE_PATH=web_app/db.sqlite3
DJANGO_DB_ENGINE=django.db.backends.mysql
MYSQL_DATABASE=picare
MYSQL_USER=picare_app
# MYSQL_PASSWORD=<16자 이상의 별도 비밀번호>
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# Docker Compose에서만 필요합니다.
# MYSQL_ROOT_PASSWORD=<별도 루트 비밀번호>
# RunPod 직접 실행 MySQL의 영속 데이터 경로입니다.
PICARE_MYSQL_DATA_DIR=/workspace/picare-mysql

# Hugging Face 모델 캐시는 RunPod 영속 volume에 보관한다.
HF_HOME=/workspace/.cache/huggingface

# v3 공식 corpus와 Chroma. PersistentClient를 쓰므로 별도 Chroma API 키는 필요 없다.
CHROMA_PATH=data/indexed/chroma_official_v3
CHROMA_COLLECTION_NAME=rpi_official
# `source_registry_v3.csv`에서 생성한 제품 추천용 공식 corpus manifest.
DOCUMENT_MANIFEST=document_pipeline/data/manifest_v3.json
# document manifest와 같은 원문·버전에서 생성한 citation-linked guide media metadata.
MEDIA_MANIFEST=document_pipeline/data/media_manifest_v3.json
# media manifest의 검수 항목을 실제 인용 청크와 연결한 재생성 산출물.
MEDIA_CHUNK_MAP=document_pipeline/data/media_chunk_map_v3.json
# 팀 검수 사실 데이터로 Git에 포함한다. 운영에서는 필요하면 volume 경로로 덮어쓴다.
PRODUCT_CATALOG=data/products/catalog.json
# Django 명령어 실험실 데이터 경로.
COMMAND_CATALOG=data/products/command_catalog.json
E5_MODEL_NAME=intfloat/multilingual-e5-base
# Normalized E5 vector의 Chroma L2 distance가 이 값 이하일 때만 Dense 근거로 사용한다.
DENSE_MAX_DISTANCE=0.48

# RunPod GPU의 실제 Qwen 추론 장치. 로컬 모델 없이 확인할 때만 auto로 바꾼다.
INFERENCE_DEVICE=cuda

# QA 답변 생성기. RunPod에서는 huggingface로 실제 Qwen을 사용한다.
# 로컬에서 모델 없이 화면·검색만 확인할 때만 template으로 바꾼다.
ANSWER_GENERATOR=huggingface

ANSWER_MODEL_ID=Qwen/Qwen3-4B-Instruct-2507
ANSWER_MODEL_REVISION=main
ANSWER_LOAD_IN_4BIT=true
ANSWER_MAX_NEW_TOKENS=768

# 제품 추천 조건 추출기. RunPod에서는 학습 완료 QLoRA adapter를 사용한다.
# LORA_ADAPTER_PATH는 실제 Pod의 adapter 위치와 일치해야 한다.
CONDITION_EXTRACTOR=lora
CONDITION_MODEL_ID=Qwen/Qwen3-4B-Instruct-2507
LORA_ADAPTER_PATH=/workspace/models/picare-qwen3-4b-qlora
CONDITION_LOAD_IN_4BIT=true
TOP_K=5
# RunPod API Key·endpoint URL은 Pod 생성/관리용이며 QA 런타임 .env에 저장하지 않는다.

# Dynamic Mini Challenge worker. Docker Compose에서는 이 값을 redis 서비스명으로 덮어쓴다.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
