PICARE_AI_BACKEND=remote
AI_API_URL=https://pod-id-8000.proxy.runpod.net
AI_API_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
AI_HTTP_TIMEOUT=10
AI_JOB_TIMEOUT=300
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-random-django-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_DB_ENGINE=django.db.backends.mysql
DJANGO_DB_NAME=picare
DJANGO_DB_USER=picare
DJANGO_DB_PASSWORD=replace-with-database-password
DJANGO_DB_HOST=database-host
DJANGO_DB_PORT=3306
