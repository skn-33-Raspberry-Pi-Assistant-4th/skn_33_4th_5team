# Copy this file to the EC2 repository root as .env, then replace all values.
# Do not commit the copied file. The release script writes PICARE_WEB_IMAGE itself.

PICARE_AI_BACKEND=remote
AI_API_URL=https://pod-id-8000.proxy.runpod.net
AI_API_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
AI_HTTP_TIMEOUT=10
AI_JOB_TIMEOUT=300

DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-random-django-secret
DJANGO_ALLOWED_HOSTS=ELASTIC_IP,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://ELASTIC_IP
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_SSL_REDIRECT=false

DJANGO_DB_ENGINE=django.db.backends.mysql
DJANGO_DB_NAME=picare
DJANGO_DB_USER=picare_app
DJANGO_DB_PASSWORD=replace-with-rds-app-password
DJANGO_DB_HOST=picare-mysql-rds.xxxxxxxxx.ap-northeast-2.rds.amazonaws.com
DJANGO_DB_PORT=3306

# t3.small: leave one worker unless traffic measurement justifies an increase.
GUNICORN_WORKERS=1
GUNICORN_TIMEOUT=30
